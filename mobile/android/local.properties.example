# Copy this file to local.properties and fill in your values.
# local.properties is gitignored — never commit it.

# Google Maps Android API key
# Obtain from: https://developers.google.com/maps/documentation/android-sdk/get-api-key
# Restrict the key to the Maps SDK for Android and to your app's SHA-1 certificate fingerprint
# in the Google Cloud Console to limit blast radius if the key is ever compromised.
GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Android SDK path (set automatically by Android Studio)
# sdk.dir=/path/to/Android/sdk
